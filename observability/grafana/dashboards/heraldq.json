    {
      "id": 9,
      "type": "barchart",
      "title": "Retry distribution — attempts by outcome",
      "description": "Attempts taken to reach a terminal state. delivered/dead-lettered come from the stored attempts column (populated for new traffic; old rows predate it); in-flight is current graphile_worker jobs. A right-shifted distribution means endpoints are forcing retries.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 44
      },
      "datasource": {
        "type": "postgres",
        "uid": "heraldq-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "delivered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dead-lettered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in-flight"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "attempt",
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "heraldq-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT attempt, sum(delivered) AS delivered, sum(dead_lettered) AS \"dead-lettered\", sum(in_flight) AS \"in-flight\" FROM ( SELECT attempts AS attempt, count(*) AS delivered, 0 AS dead_lettered, 0 AS in_flight FROM webhook_deliveries WHERE attempts IS NOT NULL GROUP BY 1 UNION ALL SELECT attempts, 0, count(*), 0 FROM dead_letter_queue WHERE attempts IS NOT NULL GROUP BY 1 UNION ALL SELECT attempts, 0, 0, count(*) FROM graphile_worker.jobs GROUP BY 1 ) t GROUP BY attempt ORDER BY attempt"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Bad endpoints — failure leaderboard (all time)",
      "description": "Destinations ranked by failures, with fail %. High-cardinality by design — this is why it lives in SQL, not a Prometheus label.",
      "gridPos": {
        "h": 9,
        "w": 24,
