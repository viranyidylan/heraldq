      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "failed",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "heraldq-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT dest AS destination, sum(delivered) AS delivered, sum(failed) AS failed, round(100.0 * sum(failed) / nullif(sum(delivered) + sum(failed), 0), 1) AS \"fail %\" FROM ( SELECT destination AS dest, count(*) AS delivered, 0 AS failed FROM webhook_deliveries GROUP BY 1 UNION ALL SELECT destination, 0, count(*) FROM dead_letter_queue GROUP BY 1 ) t GROUP BY dest ORDER BY failed DESC, \"fail %\" DESC LIMIT 25"
        }
      ]
    },
