  "query": "SELECT ak.id, ak.tenant_id, ak.expires_at,\n                    t.tier::text AS \"tier!\",\n                    t.monthly_webhook_limit_override\n                FROM api_keys ak\n                JOIN tenants t ON t.id = ak.tenant_id\n                WHERE ak.key_hash = $1 AND ak.is_active = true",
